# Server & Security Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="MY_APP_URL"

# Strong random secret for signing httpOnly admin session JWTs (at least 32 chars)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Optional PostgreSQL connection string for external deployment (Neon / Supabase)
# When omitted, the server uses embedded SQLite at data/portfolio.db
DATABASE_URL=""

# Optional Initial Admin Seed Overrides (used only when admin_users table is empty)
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""

# Optional SMTP settings for server-side email notifications on new contact messages
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
CONTACT_NOTIFY_EMAIL=""
